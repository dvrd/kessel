#assert(len(REGEX_AST_BINARY_PROPERTIES) == 99)
#assert(len(REGEX_AST_GENERAL_CATEGORIES) == 80)
#assert(len(REGEX_AST_SCRIPTS) == 349)

RegexPropertyClass :: enum { Unknown, Characters, Strings }

// Classify a lone `\p{Name}`: a binary property or a General_Category value
// matches characters; a property of strings is only legal with the `v` flag.
@(private)
regex_ast_lone_property :: proc(name: string) -> RegexPropertyClass {
	if regex_ast_sorted_contains(REGEX_AST_BINARY_PROPERTIES[:], name) { return .Characters }
	if regex_ast_sorted_contains(REGEX_AST_GENERAL_CATEGORIES[:], name) { return .Characters }
	if is_property_of_strings(name) { return .Strings }
	return .Unknown
}

// Validate `\p{Name=Value}`. Only the three non-binary properties take values.
@(private)
regex_ast_property_pair_valid :: proc(name, value: string) -> bool {
	switch name {
	case "General_Category", "gc":
		return regex_ast_sorted_contains(REGEX_AST_GENERAL_CATEGORIES[:], value)
	case "Script", "sc", "Script_Extensions", "scx":
		return regex_ast_sorted_contains(REGEX_AST_SCRIPTS[:], value)
	}
	return false
}

@(private="file")
regex_ast_sorted_contains :: proc(table: []string, name: string) -> bool {
	assert(len(table) > 0)
	_, found := slice.binary_search(table, name)
	return found
}
