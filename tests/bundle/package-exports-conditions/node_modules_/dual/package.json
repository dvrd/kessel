{
  "name": "dual",
  "exports": {
    ".": {
      "import": "./esm/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./feature": {
      "node": {
        "import": "./esm/feature.node.mjs",
        "default": "./cjs/index.cjs"
      },
      "default": "./esm/feature.browser.mjs"
    },
    "./internal/*": "./esm/internal/*",
    "./package.json": "./package.json"
  }
}
